# The AWS CLI named profile used to authenticate.
aws_profile = "wtc-development"

# The region of the existing EKS cluster.
aws_region = "eu-central-1"

# Name (id) of the existing EKS cluster to add the GPU node pool to.
cluster_name = "simphera"

# The new NVIDIA GPU driver version to roll out.
driver_version = "595.71.05"

# Optional overrides:
# kubernetes_version = "1.34"
# subnet_ids         = ["subnet-aaaa", "subnet-bbbb"]
# gpu_node_size      = ["g5.2xlarge"]
# gpu_node_count_min = 0
# gpu_node_count_max = 12
# gpu_node_disk_size = 100
# tags               = { team = "ivs" }
